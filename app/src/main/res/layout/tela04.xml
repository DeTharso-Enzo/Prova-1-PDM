<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_cadChoco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cadastro de Chocolates"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/et_idChoco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Número identificador"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_cacau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantidade de cacau (20 a 90 %)"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cor do chocolate" />

        <RadioGroup
            android:id="@+id/rg_cor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_branco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branco" />

            <RadioButton
                android:id="@+id/rb_preto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Preto" />
        </RadioGroup>

        <EditText
            android:id="@+id/et_preco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preço (R$)"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cliente (dono do chocolate)" />

        <Spinner
            android:id="@+id/sp_cliente"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <Button
            android:id="@+id/bt_cadastrarChoco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cadastrar" />

        <Button
            android:id="@+id/bt_listaChoco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ir para lista de chocolates" />

        <Button
            android:id="@+id/bt_inicio4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ir para tela inicial" />
    </LinearLayout>
</ScrollView>
